# OpenTrace Environment Configuration
PROJECT_NAME=OpenTrace
ENVIRONMENT=development
VERSION=1.0.0

# Database Configuration (Defaults to SQLite for instant local dev; can use PostgreSQL)
# Local SQLite:
DATABASE_URL=sqlite+aiosqlite:///./opentrace.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/opentrace

# Security & Authentication
SECRET_KEY=opentrace_super_secret_jwt_key_change_in_production_994812
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Celery & Redis (Optional for local dev, used in background workers)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Engine Configuration
DEFAULT_CONCURRENCY=12
DEFAULT_TIMEOUT_SECONDS=8.0
MAX_SEARCH_DEPTH=2

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

